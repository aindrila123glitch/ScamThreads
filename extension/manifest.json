{
  "manifest_version": 3,
  "name": "HackMatrix Threat Guard",
  "version": "1.2.0",
  "description": "Real-time phishing protection, automatic link interception, local lexical analysis, and smart contract threat verification.",
  "permissions": [
    "storage",
    "webNavigation",
    "declarativeNetRequest",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lexical.js",
        "inspect.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
